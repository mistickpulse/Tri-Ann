{%- from "icons.njk" import icon -%}

{%- macro mapsUrl(r) -%}https://www.google.com/maps/search/?api=1&query={{ ('Tri-Ann ' + r.city) | urlencode }}&query_place_id={{ r.placeId }}{%- endmacro -%}

{%- macro restoCard(r, lang, site, withRating) -%}
<article class="resto-card" data-hours='{{ r.hours | json }}'>
  <h3><a href="{{ site.routes | route('restaurant', lang, r.slug) }}">{{ r.city }}</a></h3>
  {%- if withRating %}
  {%- set g = googleReviews.places[r.placeId] if (googleReviews and googleReviews.places) else null %}
  <a class="rating-mini" href="https://search.google.com/local/reviews?placeid={{ r.placeId }}" target="_blank" rel="noopener">
    {%- if g and g.rating %}
    <b>{{ g.rating | score(lang) }}</b><span class="stars" aria-label="{{ g.rating }}/5">{{ g.rating | stars }}</span><small class="muted google-count">{{ googleLogo(14) }} {{ g.count }} {{ "reviews.count" | t(lang) }} Google</small>
    {%- else %}
    {{ googleLogo(18) }}<small class="muted">{{ "Lire les avis Google" if lang == "fr" else "Read our Google reviews" }}</small>
    {%- endif %}
  </a>
  {%- endif %}
  <p class="status" data-status data-lang="{{ lang }}"></p>
  <p class="muted">{{ r.landmark | tr(lang) }}</p>
  <p class="muted small">{{ r.hours | hoursSummary(lang) }}</p>
  <div class="actions">
    <a class="btn btn-primary" href="tel:{{ r.phoneIntl }}">{{ icon("phone", 18) }} {{ "nav.call" | t(lang) }}</a>
    <a class="btn btn-ghost" href="{{ mapsUrl(r) }}" target="_blank" rel="noopener">{{ icon("pin", 18) }} {{ "nav.directions" | t(lang) }}</a>
  </div>
  <a class="more" href="{{ site.routes | route('restaurant', lang, r.slug) }}">{{ "resto.more" | t(lang) }} {{ icon("arrow", 16) }}</a>
</article>
{%- endmacro -%}

{%- macro specialCard(s, lang) -%}
<article class="special-card">
  {%- if s.data.image %}<img src="{{ s.data.image }}" alt="" loading="lazy" width="600" height="450">{% endif %}
  <div class="body">
    <span class="tag">{{ ("specialTypes." + s.data.type) | t(lang) }}</span>
    <h3>{{ s.data.name }}</h3>
    <p class="muted">{{ s.data.description_en if lang == "en" and s.data.description_en else s.data.description }}</p>
    {%- if s.data.price %}<p class="price">{{ s.data.price | price(lang) }}</p>{% endif %}
  </div>
</article>
{%- endmacro -%}

{%- macro eventRow(e, lang, restaurants) -%}
<article class="event-row">
  <div class="event-when">
    {%- if e.data.date %}<time datetime="{{ e.data.date | dateIso }}">{{ e.data.date | dateShort(lang) }}</time>
    {%- else %}<span>{{ e.data.recurring_en if lang == "en" and e.data.recurring_en else e.data.recurring }}</span>{% endif %}
  </div>
  <div>
    <h3>{{ e.data.name_en if lang == "en" and e.data.name_en else e.data.name }}</h3>
    <p class="muted">{{ e.data.description_en if lang == "en" and e.data.description_en else e.data.description }}</p>
    <p class="small where">{{ icon("pin", 14) }}
      {%- if not e.data.restaurants or ("tous" in e.data.restaurants) %} Moussy-le-Neuf, Lagny-le-Sec, Saint-Maximin
      {%- else %} {% for s in e.data.restaurants %}{% for r in restaurants %}{% if r.slug == s %}{{ r.city }}{% endif %}{% endfor %}{% if not loop.last %}, {% endif %}{% endfor %}{% endif %}
    </p>
  </div>
</article>
{%- endmacro -%}

{%- macro reviewsBlock(places, lang, restaurants) -%}
<div class="reviews">
  <div class="ratings">
    {%- for r in restaurants %}{% if r.slug in places %}
    {%- set g = googleReviews.places[r.placeId] if (googleReviews and googleReviews.places) else null %}
    <a class="rating" href="https://search.google.com/local/reviews?placeid={{ r.placeId }}" target="_blank" rel="noopener">
      {%- if g and g.rating %}
      <span class="score">{{ g.rating | score(lang) }}</span>
      <span><span class="stars" aria-label="{{ g.rating }}/5">{{ g.rating | stars }}</span><b>{{ r.city }}</b><small class="muted google-count">{{ googleLogo(14) }} {{ g.count }} {{ "reviews.count" | t(lang) }} Google</small></span>
      {%- else %}
      <span class="score">{{ googleLogo(26) }}</span>
      <span><b>{{ r.city }}</b><small class="muted">{{ "Lire les avis Google" if lang == "fr" else "Read our Google reviews" }}</small></span>
      {%- endif %}
    </a>
    {%- endif %}{% endfor %}
  </div>
  {{ quotesList(places, lang, restaurants) }}
</div>
{%- endmacro -%}

{%- macro googleLogo(size) -%}
<svg class="google-logo" width="{{ size or 18 }}" height="{{ size or 18 }}" viewBox="0 0 48 48" role="img" aria-label="Google"><path fill="#FFC107" d="M43.6 20.1H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 13 4 4 13 4 24s9 20 20 20 20-9 20-20c0-1.3-.1-2.6-.4-3.9z"/><path fill="#FF3D00" d="m6.3 14.7 6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/><path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/><path fill="#1976D2" d="M43.6 20.1H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.6-.4-3.9z"/></svg>
{%- endmacro -%}

{%- macro quotesList(places, lang, restaurants) -%}
{%- set quotes = googleReviews | reviewQuotes(restaurants, places) %}
{%- if quotes.length %}
<div class="quotes-carousel" data-carousel>
<div class="quotes" aria-label="{{ 'reviews.title' | t(lang) }}" tabindex="0" data-carousel-track>
  {%- for q in quotes %}
  <article class="quote">
    <div class="quote-head"><span class="stars" aria-label="{{ q.rating }}/5">{{ q.rating | stars }}</span><span class="google-tag">{{ googleLogo(18) }} {{ "Avis Google" if lang == "fr" else "Google review" }}</span></div>
    <p>{{ q.text | excerpt }}</p>
    <footer class="quote-author">
      {%- if q.photo %}<img class="avatar" src="{{ q.photo }}" alt="" width="40" height="40" loading="lazy" referrerpolicy="no-referrer">
      {%- else %}<span class="avatar" aria-hidden="true">{{ q.author | first | upper }}</span>{% endif %}
      <span><b>{{ q.author }}</b><br>{{ q.label }}{% if q.date %} · {{ q.date | reviewDate(lang) }}{% endif %}</span>
    </footer>
  </article>
  {%- endfor %}
</div>
<button class="icon-btn carousel-btn prev" type="button" data-carousel-prev aria-label="{{ 'Avis précédent' if lang == 'fr' else 'Previous review' }}">{{ icon("arrow", 18) }}</button>
<button class="icon-btn carousel-btn next" type="button" data-carousel-next aria-label="{{ 'Avis suivant' if lang == 'fr' else 'Next review' }}">{{ icon("arrow", 18) }}</button>
</div>
<p class="muted small quotes-note">{{ "Une sélection d'avis Google. Tous les avis sont visibles sur Google en cliquant sur la note de chaque restaurant." if lang == "fr" else "A selection of Google reviews. All reviews can be read on Google by clicking each restaurant's rating." }}</p>{% endif %}
{%- endmacro -%}

{%- macro eventsCalendar(events, lang, restaurants, only) -%}
<div class="calendar" data-calendar data-lang="{{ lang }}" data-only="{{ only or '' }}" data-empty="{{ 'calendar.noneThisMonth' | t(lang) }}" data-title-current="{{ 'calendar.upcoming' | t(lang) }}" data-title-month="{{ 'calendar.inMonth' | t(lang) }}" data-book-title="{{ 'calendar.bookTitle' | t(lang) }}" data-book-label="{{ 'calendar.book' | t(lang) }}" data-book-note="{{ 'resto.booking' | t(lang) }}" data-book-close="{{ 'menu.close' | t(lang) }}">
  <div class="cal-main">
    <div class="cal-head">
      <button class="icon-btn" type="button" data-cal-prev aria-label="{{ 'calendar.prev' | t(lang) }}">{{ icon("arrow", 18) }}</button>
      <h3 class="cal-title" data-cal-title aria-live="polite"></h3>
      <button class="icon-btn" type="button" data-cal-next aria-label="{{ 'calendar.next' | t(lang) }}">{{ icon("arrow", 18) }}</button>
    </div>
    {%- if not only %}
    <div class="cal-legend" role="group" aria-label="{{ 'calendar.filter' | t(lang) }}">
      <button type="button" data-cal-filter="" aria-pressed="true">{{ "calendar.all" | t(lang) }}</button>
      {%- for r in restaurants %}
      <button type="button" data-cal-filter="{{ r.slug }}" aria-pressed="false"><span class="cal-dot" style="--c:{{ r.color }}"></span>{{ r.city }}</button>
      {%- endfor %}
    </div>
    {%- endif %}
    <div class="cal-weekdays" aria-hidden="true">
      {%- for d in ["mon", "tue", "wed", "thu", "fri", "sat", "sun"] %}<span>{{ (("days." + d) | t(lang)) | truncate(3, true, "") }}</span>{% endfor %}
    </div>
    <div class="cal-grid" data-cal-grid></div>
  </div>
  <aside class="cal-side">
    <div class="cal-detail" data-cal-detail aria-live="polite" hidden></div>
    <h3 class="cal-side-title" data-cal-side-title>{{ "calendar.upcoming" | t(lang) }}</h3>
    <ul class="cal-upcoming" data-cal-upcoming></ul>
    {%- set undated = events | undatedEvents(restaurants, only) %}
    {%- if undated.length %}
    <div class="cal-regular">
      {%- for e in undated %}
      <p>{% if e.icon %}<span class="up-ic">{{ e.icon | eventIcon }}</span>{% endif %}<b>{{ e.name | tr(lang) }}</b><br>
      <span class="muted small">{{ e.recurring | tr(lang) }}</span><br>
      <span class="cal-where">{% for r in e.restaurants %}<span class="cal-tag" style="--c:{{ r.color }}">{{ r.city }}</span>{% endfor %}</span></p>
      {%- endfor %}
    </div>
    {%- endif %}
  </aside>
  <script type="application/json" data-calendar-data>{{ events | calendarData(restaurants, googleReviews, avisManuels) | safe }}</script>
  <noscript><p class="muted">{{ "calendar.noscript" | t(lang) }}</p></noscript>
</div>
{%- endmacro -%}

{%- macro newsletterCta(lang) -%}
<div class="newsletter-cta">
  <span class="newsletter-ic">{{ icon("mail", 24) }}</span>
  <div>
    <h3>{{ "newsletter.title" | t(lang) }}</h3>
    <p class="muted">{{ "newsletter.text" | t(lang) }} {{ "newsletter.text" | rtag }}</p>
  </div>
  <button class="btn btn-primary" type="button" data-open-dialog="newsletter-dialog">{{ icon("mail", 18) }} {{ "newsletter.cta" | t(lang) }}</button>
</div>
{%- endmacro -%}
