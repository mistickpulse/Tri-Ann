---
# Espace équipe : outil de menus (groupes, événements) et outil de factures (src/_includes/admin-factures.njk). Construit en clair dans _site/admin/_outil.html,
# puis chiffré par scripts/chiffrer-admin.mjs et supprimé : il n'est jamais publié lisible.
permalink: /admin/_outil.html
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Tri-Ann · Espace équipe</title>
<link rel="icon" href="/assets/img/favicon-32.png" sizes="32x32">
<style>
  @font-face { font-family: "Playfair Display"; font-weight: 700; src: url("/assets/fonts/playfair-display-latin-700-normal.woff2") format("woff2"); }
  @font-face { font-family: "Inter"; font-weight: 100 900; src: url("/assets/fonts/inter-latin-wght-normal.woff2") format("woff2"); }
  :root { --bg: #141110; --bg2: #1c1816; --surface: #241f1c; --ink: #f1e9df; --muted: #b3a597; --line: #3a322c; --accent: #8fa8b5; --ko: #e08a7a; }
  * { box-sizing: border-box; }
  body { margin: 0; background: var(--bg); color: var(--ink); font: 400 15px/1.5 "Inter", system-ui, sans-serif; }
  button, input, select, textarea { font: inherit; }
  .bar { position: sticky; top: 0; z-index: 5; display: flex; flex-wrap: wrap; align-items: center; gap: 8px; padding: 10px 16px; background: var(--bg2); border-bottom: 1px solid var(--line); }
  .bar img { width: 36px; height: 36px; border-radius: 8px; }
  .bar h1 { font: 700 1.2rem "Playfair Display", serif; margin: 0 auto 0 4px; }
  .btn { border: 1px solid var(--line); background: var(--surface); color: var(--ink); border-radius: 999px; padding: .5em 1em; cursor: pointer; font-weight: 600; }
  .btn:hover { border-color: var(--accent); }
  .btn.primary { background: var(--accent); color: #141110; border-color: var(--accent); }
  .btn.small { padding: .25em .7em; font-size: .85rem; }
  .btn.danger { color: var(--ko); }
  main { display: grid; grid-template-columns: minmax(340px, 480px) 1fr; gap: 20px; padding: 16px; align-items: start; }
  main > * { min-width: 0; }
  @media (max-width: 980px) { main { grid-template-columns: 1fr; } }
  .editor { display: grid; gap: 14px; }
  .card { background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 14px; display: grid; gap: 10px; }
  .card h2 { margin: 0; font: 700 1.05rem "Playfair Display", serif; }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; }
  label.f { display: grid; gap: 4px; font-size: .82rem; color: var(--muted); font-weight: 600; }
  input, select, textarea { width: 100%; color: var(--ink); background: var(--bg); border: 1px solid var(--line); border-radius: 8px; padding: .55em .7em; }
  textarea { min-height: 64px; resize: vertical; }
  input, select, textarea, .row > * { min-width: 0; }
  input:focus, select:focus, textarea:focus { outline: 2px solid var(--accent); border-color: var(--accent); }
  .course { border: 1px solid var(--line); border-radius: 12px; padding: 10px; display: grid; gap: 8px; background: var(--bg2); }
  .course-head { display: flex; gap: 6px; align-items: center; }
  .course-head input { font-weight: 700; }
  .items { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; }
  .items li { display: grid; grid-template-columns: 1fr 86px auto; gap: 6px; background: var(--surface); border-radius: 8px; padding: 8px; }
  .items li textarea { grid-column: 1 / -1; min-height: 40px; font-size: .88rem; }
  .items .tools { display: flex; gap: 4px; }
  .items input[data-k="n"] { font-weight: 700; }
  .course-note { font-size: .88rem; }
  .toggles { display: grid; gap: 6px; }
  .theo { border: 1px dashed var(--accent); border-radius: 10px; padding: 10px 12px; font-size: .9rem; }
  .theo b { color: var(--accent); }
  .theo small { display: block; color: var(--muted); }
  .muted { color: var(--muted); font-size: .85rem; margin: 0; }
  .check { display: flex; gap: 8px; align-items: center; font-size: .88rem; color: var(--muted); }
  .check input { width: auto; }
  .saved { list-style: none; margin: 0; padding: 0; display: grid; gap: 6px; max-height: 260px; overflow: auto; }
  .saved li { display: flex; gap: 6px; align-items: center; }
  .saved li span { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .preview-wrap { position: sticky; top: 72px; }
  /* Téléphone : barre compacte qui ne reste pas collée, aperçu sous l'éditeur */
  @media (max-width: 700px) {
    .bar { position: static; padding: 8px 12px; gap: 6px; }
    .bar img { width: 30px; height: 30px; }
    .bar h1 { font-size: 1rem; }
    .bar .btn { padding: .45em .6em; font-size: .8rem; white-space: nowrap; }
    .bar [data-act="logout"] { order: 1; }
    .tabs { flex-basis: 100%; order: 2; margin: 0; }
    .bar .only-menus, .bar .only-factures { order: 3; flex: 1; }
    .tabs button { flex: 1; }
    main { padding: 12px; gap: 14px; }
    .preview-wrap { position: static; }
  }
  .help { margin: 0 0 8px; color: var(--muted); font-size: .85rem; }
  /* Liste des plats de la carte sous les champs « Ajouter un plat / une ligne » */
  .suggest { position: fixed; z-index: 20; margin: 0; padding: 4px; list-style: none; overflow-y: auto; background: var(--surface); border: 1px solid var(--accent); border-radius: 10px; box-shadow: 0 14px 40px rgba(0,0,0,.55); }
  .suggest li { display: grid; grid-template-columns: 1fr auto; gap: 0 12px; align-items: center; padding: 8px 10px; border-radius: 7px; cursor: pointer; }
  .suggest li b { font-weight: 650; }
  .suggest li small { grid-column: 1; color: var(--muted); font-size: .8rem; }
  .suggest li span { grid-row: 1 / span 2; grid-column: 2; color: var(--accent); font-weight: 700; white-space: nowrap; }
  .suggest li[aria-selected="true"] { background: var(--bg2); outline: 1px solid var(--line); }
  .suggest li.free { display: block; color: var(--muted); font-size: .88rem; border-top: 1px solid var(--line); border-radius: 0 0 7px 7px; }
  .suggest li.free b { color: var(--ink); }
  .tabs { display: flex; gap: 4px; margin-right: auto; background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 3px; }
  .tabs button { border: 0; background: none; color: var(--muted); border-radius: 999px; padding: .35em .9em; cursor: pointer; font-weight: 600; }
  .tabs button[aria-pressed="true"] { background: var(--accent); color: #141110; }
  /* Une seule vue à la fois : menus ou factures */
  body:not([data-view="factures"]) .view-factures, body:not([data-view="factures"]) .only-factures,
  body[data-view="factures"] .view-menus, body[data-view="factures"] .only-menus { display: none !important; }

  /* Aperçu = le document remis au client (A4) */
  .sheet { --ink2: #2a211b; --muted2: #6b625b; --acc: #4f6875; background: #fbf8f3; color: var(--ink2); width: 210mm; min-height: 297mm; margin: 0 auto; padding: 16mm 16mm 14mm; box-shadow: 0 20px 60px rgba(0,0,0,.5); display: flex; flex-direction: column; font-size: 10.5pt; }
  .sheet header { display: flex; gap: 14px; align-items: center; padding-bottom: 10px; border-bottom: 2px solid var(--acc); }
  .sheet header img { width: 58px; height: 58px; border-radius: 10px; }
  .sheet header b { display: block; font: 700 14pt "Playfair Display", serif; }
  .sheet header span { color: var(--muted2); font-size: 9pt; }
  .sheet .title { text-align: center; margin: 14mm 0 2mm; font: 700 26pt/1.1 "Playfair Display", serif; color: var(--ink2); }
  .sheet .meta { text-align: center; color: var(--muted2); margin: 0; }
  .sheet .intro { text-align: center; max-width: 140mm; margin: 6mm auto 0; font-style: italic; color: var(--muted2); white-space: pre-line; }
  .sheet .courses { margin: 10mm auto 0; width: 100%; max-width: 150mm; text-align: center; }
  .sheet .course-t { font: 700 12pt "Playfair Display", serif; color: var(--acc); text-transform: uppercase; letter-spacing: .12em; margin: 7mm 0 2mm; }
  .sheet .course-t::before, .sheet .course-t::after { content: "—"; margin: 0 .6em; color: #c8bdb0; }
  .sheet .dish { margin: 0 0 2.5mm; }
  .sheet .dish b { font-size: 11.5pt; }
  .sheet .dish .ip { color: var(--acc); font-weight: 700; margin-left: .4em; }
  .sheet .dish small { display: block; color: var(--muted2); font-size: 9pt; }
  .sheet .dish em { display: block; color: #8a6d1f; font-size: 8pt; font-style: normal; }
  .sheet .or { color: var(--muted2); font-style: italic; font-size: 9pt; margin: 0 0 2.5mm; }
  .sheet .price { margin: 10mm auto 0; text-align: center; }
  .sheet .price b { display: inline-block; font: 700 20pt "Playfair Display", serif; color: var(--acc); border: 2px solid var(--acc); border-radius: 999px; padding: 1mm 8mm; }
  .sheet .price span { display: block; color: var(--muted2); font-size: 9pt; margin-top: 2mm; }
  .sheet .price .theo-line { font-size: 9.5pt; }
  .sheet .price .theo-line s { color: var(--muted2); }
  .sheet .author { margin: 8mm 0 0; text-align: center; font: italic 10pt "Playfair Display", serif; color: var(--ink2); }
  .sheet .mentions { margin-top: auto; padding-top: 8mm; color: var(--muted2); font-size: 8.5pt; white-space: pre-line; text-align: center; }
  .sheet footer { margin-top: 4mm; padding-top: 3mm; border-top: 1px solid #ddd3c7; text-align: center; color: var(--muted2); font-size: 8.5pt; }

  @media print {
    @page { size: A4; margin: 0; }
    html, body { background: #fbf8f3; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .bar, .editor, .help { display: none !important; }
    main { display: block; padding: 0; }
    .preview-wrap { position: static; }
    .sheet { box-shadow: none; width: 210mm; min-height: 297mm; margin: 0; zoom: 1 !important; }
  }
</style>
</head>
<body>
<div class="bar">
  <img src="/assets/img/logo-96.jpg" alt="">
  <h1>Espace équipe</h1>
  <nav class="tabs" aria-label="Outil"><button type="button" data-view="menus">Menus</button><button type="button" data-view="factures">Factures</button></nav>
  <button class="btn only-menus" type="button" data-act="new">Nouveau</button>
  <button class="btn only-menus" type="button" data-act="save">Enregistrer</button>
  <button class="btn primary only-menus" type="button" data-act="print">Télécharger le PDF</button>
  <button class="btn only-factures" type="button" data-fx-act="new">Nouvelle facture</button>
  <button class="btn only-factures" type="button" data-fx-act="save">Enregistrer</button>
  <button class="btn primary only-factures" type="button" data-fx-act="print">Télécharger le PDF</button>
  <button class="btn small" type="button" data-act="logout" title="Oublier le code sur cet appareil">Se déconnecter</button>
</div>

<main class="view-menus">
  <div class="editor">
    <section class="card">
      <h2>Le menu</h2>
      <label class="f">Modèle de départ
        <select data-template>
          <option value="">— Choisir un modèle —</option>
          <option value="groupe">Menu groupe</option>
          <option value="anniversaire">Menu anniversaire</option>
          <option value="entreprise">Menu entreprise</option>
          <option value="enfant">Menu enfant</option>
        </select>
      </label>
      <label class="f">Restaurant
        <select data-f="resto">{% for r in restaurants %}<option value="{{ r.slug }}">{{ r.name }} – {{ r.city }}</option>{% endfor %}</select>
      </label>
      <label class="f">Titre<input data-f="title" placeholder="Menu anniversaire"></label>
      <label class="f">Proposé par<input data-f="author" placeholder="Prénom (et rôle), ex. Steph, responsable"></label>
      <div class="row">
        <label class="f">Client<input data-f="client" placeholder="Famille Martin"></label>
        <label class="f">Date<input data-f="date" type="date"></label>
      </div>
      <div class="row">
        <label class="f">Nombre de personnes<input data-f="guests" type="number" min="1"></label>
        <label class="f">Prix par personne (€, vide = pas de prix)<input data-f="price" type="number" min="0" step="0.1"></label>
      </div>
      <label class="f">Précision sous le prix<input data-f="priceNote" placeholder="Boissons non comprises"></label>
      <label class="f">Petit mot d'introduction (facultatif)<textarea data-f="intro" placeholder="Nous sommes heureux de vous accueillir…"></textarea></label>
    </section>

    <section class="card">
      <h2>Les plats</h2>
      <p class="muted">Pour chaque étape, cherchez un plat de la carte ou écrivez un plat libre, puis Entrée. Plusieurs plats dans une étape = au choix.</p>
      <div data-courses></div>
      <button class="btn" type="button" data-act="add-course">+ Ajouter une étape</button>
      <div class="theo" data-theo></div>
      <div class="toggles">
        <label class="check"><input type="checkbox" data-f="showItemPrices"> Afficher le prix de chaque plat (prix vide = non affiché)</label>
        <label class="check"><input type="checkbox" data-f="showTheo"> Afficher le prix à la carte dans le menu</label>
        <label class="check"><input type="checkbox" data-f="showDesc" checked> Afficher les descriptions</label>
        <label class="check"><input type="checkbox" data-f="showAllergens"> Afficher les allergènes sous chaque plat</label>
        <label class="check"><input type="checkbox" data-f="showOr" checked> Écrire « ou » entre les plats d'une même étape</label>
      </div>
    </section>

    <section class="card">
      <h2>Mentions</h2>
      <textarea data-f="mentions"></textarea>
    </section>

    <section class="card">
      <h2>Menus enregistrés <small class="muted">(sur cet appareil)</small></h2>
      <ul class="saved" data-saved></ul>
      <div class="row">
        <button class="btn small" type="button" data-act="export">Exporter (fichier)</button>
        <label class="btn small" style="text-align:center">Importer<input type="file" accept=".json" data-import hidden></label>
      </div>
    </section>
  </div>

  <div class="preview-wrap">
    <p class="help">Aperçu du document remis au client. « Télécharger le PDF » ouvre l'impression : choisissez « Enregistrer au format PDF ».</p>
    <article class="sheet" data-sheet></article>
  </div>
</main>

<script type="application/json" id="data-catalog">{{ menu | menuCatalog(drinks, collections.specials) | safe }}</script>
<script type="application/json" id="data-restos">{{ restaurants | json | safe }}</script>
<script type="application/json" id="data-banques">{{ banques | json | safe }}</script>
<script type="application/json" id="data-allergens">{{ site.allergens | json | safe }}</script>
<script>
(() => {
  const $ = (s, el = document) => el.querySelector(s);
  const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
  const CATALOG = JSON.parse($("#data-catalog").textContent);
  const RESTOS = JSON.parse($("#data-restos").textContent);
  const ALLERGENS = Object.fromEntries(JSON.parse($("#data-allergens").textContent).map((a) => [a.id, a.fr]));
  const STORE = "triann-menus";
  const label = (c) => `${c.n} — ${c.g}`;

  const MENTIONS = "Menu établi pour l'ensemble du groupe, à confirmer au plus tard 7 jours avant la date.\nMerci de nous signaler toute allergie ou régime particulier.\nPrix nets en euros, service compris.";
  const TEMPLATES = {
    groupe: { title: "Menu groupe", courses: ["Apéritif", "Galette", "Crêpe", "Boisson"], priceNote: "Boissons non comprises sauf mention" },
    anniversaire: { title: "Menu anniversaire", courses: ["Apéritif", "Galette", "Dessert"], priceNote: "", intro: "Une attention particulière sera apportée au dessert… surprise, surprise 😉" },
    entreprise: { title: "Menu entreprise", courses: ["Galette", "Crêpe", "Boisson chaude"], priceNote: "Boissons non comprises sauf mention" },
    enfant: { title: "Menu enfant", courses: ["Plat", "Dessert", "Boisson"], priceNote: "" },
  };
  const lastAuthor = () => { try { return localStorage.getItem("triann-menus-auteur") || ""; } catch { return ""; } };
  const blank = () => ({ id: Date.now().toString(36), author: lastAuthor(), resto: RESTOS[0].slug, title: "", client: "", date: "", guests: "", price: "", priceNote: "", intro: "", courses: [{ t: "Galette", items: [] }, { t: "Dessert", items: [] }], showAllergens: false, showItemPrices: false, showTheo: false, showDesc: true, showOr: true, mentions: MENTIONS });
  let m = blank();

  // ---------- Éditeur ----------
  const fields = document.querySelectorAll("[data-f]");
  function fill() {
    fields.forEach((el) => { const k = el.dataset.f; if (el.type === "checkbox") el.checked = !!m[k]; else el.value = m[k] ?? ""; });
    renderCourses(); render();
  }
  fields.forEach((el) => el.addEventListener("input", () => {
    m[el.dataset.f] = el.type === "checkbox" ? el.checked : el.value;
    if (el.dataset.f === "author") try { localStorage.setItem("triann-menus-auteur", el.value); } catch { /* navigation privée */ }
    render();
  }));

  const coursesEl = $("[data-courses]");
  function renderCourses() {
    coursesEl.innerHTML = m.courses.map((c, i) => `
      <div class="course" data-i="${i}">
        <div class="course-head">
          <input value="${esc(c.t)}" data-course-title aria-label="Nom de l'étape">
          <button class="btn small" type="button" data-up title="Monter">↑</button>
          <button class="btn small" type="button" data-down title="Descendre">↓</button>
          <button class="btn small danger" type="button" data-del-course title="Supprimer l'étape">✕</button>
        </div>
        <input class="course-note" value="${esc(c.note || "")}" data-course-note placeholder="Note facultative (ex. au choix, à partager)">
        <ul class="items">${c.items.map((it, j) => `<li data-j="${j}">
          <input value="${esc(it.n)}" data-k="n" aria-label="Nom du plat">
          <input value="${it.p ?? ""}" data-k="p" type="number" min="0" step="0.1" placeholder="Prix" aria-label="Prix (vide = pas de prix)">
          <span class="tools"><button class="btn small" type="button" data-item-up title="Monter">↑</button><button class="btn small danger" type="button" data-del-item="${j}" title="Retirer">✕</button></span>
          <textarea data-k="d" placeholder="Description / ingrédients (facultatif)">${esc(it.d)}</textarea>
        </li>`).join("")}</ul>
        <input data-suggest autocomplete="off" placeholder="Ajouter un plat (recherche ou texte libre) puis Entrée" data-add-item>
      </div>`).join("");
  }
  coursesEl.addEventListener("input", (e) => {
    const box = e.target.closest(".course"); if (!box) return;
    const c = m.courses[+box.dataset.i];
    if (e.target.matches("[data-course-title]")) { c.t = e.target.value; render(); }
    if (e.target.matches("[data-course-note]")) { c.note = e.target.value; render(); }
    const li = e.target.closest("li[data-j]");
    if (li && e.target.dataset.k) { const it = c.items[+li.dataset.j]; const k = e.target.dataset.k; it[k] = k === "p" ? (e.target.value === "" ? null : Number(e.target.value)) : e.target.value; render(); }
    // Choix dans la liste de la carte : ajout direct
    if (e.target.matches("[data-add-item]")) {
      const hit = CATALOG.find((x) => label(x) === e.target.value);
      if (hit) { c.items.push({ n: hit.n, d: hit.d, a: hit.a, p: hit.p, pc: hit.p }); renderCourses(); render(); coursesEl.querySelector(`.course[data-i="${box.dataset.i}"] [data-add-item]`).focus(); }
    }
  });
  coursesEl.addEventListener("keydown", (e) => {
    if (e.key !== "Enter" || !e.target.matches("[data-add-item]")) return;
    e.preventDefault();
    const v = e.target.value.trim(); if (!v) return;
    const box = e.target.closest(".course");
    m.courses[+box.dataset.i].items.push({ n: v, d: "", a: null, p: null });
    renderCourses(); render();
    coursesEl.querySelector(`.course[data-i="${box.dataset.i}"] [data-add-item]`).focus();
  });
  coursesEl.addEventListener("click", (e) => {
    const box = e.target.closest(".course"); if (!box) return;
    const i = +box.dataset.i, cs = m.courses;
    if (e.target.matches("[data-del-item]")) cs[i].items.splice(+e.target.dataset.delItem, 1);
    else if (e.target.matches("[data-item-up]")) { const j = +e.target.closest("li").dataset.j; if (j > 0) [cs[i].items[j - 1], cs[i].items[j]] = [cs[i].items[j], cs[i].items[j - 1]]; else return; }
    else if (e.target.matches("[data-del-course]")) cs.splice(i, 1);
    else if (e.target.matches("[data-up]") && i > 0) [cs[i - 1], cs[i]] = [cs[i], cs[i - 1]];
    else if (e.target.matches("[data-down]") && i < cs.length - 1) [cs[i + 1], cs[i]] = [cs[i], cs[i + 1]];
    else return;
    renderCourses(); render();
  });

  $("[data-template]").addEventListener("change", (e) => {
    const t = TEMPLATES[e.target.value]; if (!t) return;
    const keep = { resto: m.resto, client: m.client, date: m.date, guests: m.guests, author: m.author };
    m = { ...blank(), ...keep, title: t.title, priceNote: t.priceNote, intro: t.intro || "", courses: t.courses.map((x) => ({ t: x, items: [] })) };
    e.target.value = ""; fill();
  });

  // ---------- Aperçu ----------
  const fmtPrice = (v) => (v === "" || v == null ? "" : Number(v).toFixed(2).replace(".", ",") + " €");
  const fmtDate = (d) => (d ? new Date(d + "T12:00").toLocaleDateString("fr-FR", { weekday: "long", day: "numeric", month: "long", year: "numeric" }) : "");
  // Prix théorique « à la carte » : pour chaque étape, le client prend un plat (le moins cher → le plus cher)
  function theoretical() {
    let min = 0, max = 0, missing = 0;
    for (const c of m.courses) {
      const prices = c.items.map((it) => it.pc ?? it.p).filter((v) => v != null && v !== "").map(Number);
      missing += c.items.length - prices.length;
      if (prices.length) { min += Math.min(...prices); max += Math.max(...prices); }
    }
    return { min, max, missing };
  }
  const fmtRange = (t) => (Math.abs(t.max - t.min) < 0.005 ? fmtPrice(t.min) : `de ${fmtPrice(t.min)} à ${fmtPrice(t.max)}`);

  function render() {
    const t = theoretical();
    const menuPrice = m.price === "" || m.price == null ? null : Number(m.price);
    $("[data-theo]").innerHTML = t.max
      ? `Prix à la carte pour un client : <b>${fmtRange(t)}</b> par personne${menuPrice != null ? `<small>Prix du menu : ${fmtPrice(menuPrice)} → ${menuPrice <= t.min ? "le client économise " + fmtRange({ min: t.min - menuPrice, max: t.max - menuPrice }) : menuPrice >= t.max ? "le menu est plus cher que la carte de " + fmtRange({ min: menuPrice - t.max, max: menuPrice - t.min }) : "selon les choix, plus ou moins cher que la carte"}</small>` : ""}${t.missing ? `<small>${t.missing} plat(s) sans prix carte non compté(s).</small>` : ""}`
      : `<small>Le prix à la carte s'affichera ici en ajoutant des plats.</small>`;
    const r = RESTOS.find((x) => x.slug === m.resto) || RESTOS[0];
    const meta = [m.client, fmtDate(m.date), m.guests ? `${m.guests} personne${m.guests > 1 ? "s" : ""}` : ""].filter(Boolean).join(" · ");
    const courses = m.courses.filter((c) => c.t || c.items.length).map((c) => `
      <div class="course-t">${esc(c.t)}</div>${c.note ? `<p class="or">${esc(c.note)}</p>` : ""}
      ${c.items.map((it, j) => `${j && m.showOr !== false ? `<p class="or">ou</p>` : ""}<div class="dish"><b>${esc(it.n)}</b>${m.showItemPrices && it.p != null && it.p !== "" ? ` <span class="ip">${fmtPrice(it.p)}</span>` : ""}${m.showDesc !== false && it.d ? `<small>${esc(it.d)}</small>` : ""}${m.showAllergens && it.a && it.a.length ? `<em>Allergènes : ${it.a.map((a) => esc(ALLERGENS[a] || a)).join(", ")}</em>` : ""}</div>`).join("") || `<p class="or">…</p>`}`).join("");
    $("[data-sheet]").innerHTML = `
      <header><img src="/assets/img/logo-96.jpg" alt=""><div><b>${esc(r.name)} – ${esc(r.city)}</b><span>${esc(r.street)}, ${esc(r.postalCode)} ${esc(r.city)} · ${esc(r.phone)}</span></div></header>
      <h2 class="title">${esc(m.title || "Notre menu")}</h2>
      ${meta ? `<p class="meta">${esc(meta)}</p>` : ""}
      ${m.intro ? `<p class="intro">${esc(m.intro)}</p>` : ""}
      <div class="courses">${courses}</div>
      ${m.price !== "" || (m.showTheo && t.max) ? `<div class="price">${m.price !== "" ? `<b>${fmtPrice(m.price)}</b><span>par personne${m.priceNote ? " · " + esc(m.priceNote) : ""}</span>` : ""}${m.showTheo && t.max ? `<span class="theo-line">Valeur à la carte : <s>${fmtRange(t)}</s></span>` : ""}</div>` : ""}
      ${m.author ? `<p class="author">Menu proposé par ${esc(m.author)}</p>` : ""}
      <div class="mentions">${esc(m.mentions)}</div>
      <footer>Crêperie bretonne Tri-Ann · tri-ann.fr</footer>`;
    document.title = ["Menu", m.title, m.client, m.date].filter(Boolean).join(" - ");
  }

  // ---------- Enregistrement (sur l'appareil) ----------
  const load = () => { try { return JSON.parse(localStorage.getItem(STORE) || "[]"); } catch { return []; } };
  const store = (list) => { try { localStorage.setItem(STORE, JSON.stringify(list)); } catch { alert("Impossible d'enregistrer sur cet appareil (navigation privée ?)."); } };
  function renderSaved() {
    const list = load().sort((a, b) => (b.saved || "").localeCompare(a.saved || ""));
    $("[data-saved]").innerHTML = list.length ? list.map((x) => `<li><span>${esc(x.title || "Sans titre")}${x.client ? " · " + esc(x.client) : ""}${x.date ? " · " + esc(x.date) : ""}</span>
      <button class="btn small" type="button" data-open="${x.id}">Ouvrir</button><button class="btn small" type="button" data-copy="${x.id}">Dupliquer</button><button class="btn small danger" type="button" data-remove="${x.id}">✕</button></li>`).join("") : `<li class="muted">Aucun menu enregistré.</li>`;
  }
  $("[data-saved]").addEventListener("click", (e) => {
    const list = load(), b = e.target.closest("button"); if (!b) return;
    const id = b.dataset.open || b.dataset.copy || b.dataset.remove, x = list.find((y) => y.id === id); if (!x) return;
    if (b.dataset.open) { m = { ...blank(), ...structuredClone(x) }; fill(); }
    if (b.dataset.copy) { m = { ...structuredClone(x), id: Date.now().toString(36), client: "", date: "", guests: "" }; fill(); }
    if (b.dataset.remove && confirm(`Supprimer « ${x.title || "Sans titre"} » ?`)) { store(list.filter((y) => y.id !== id)); renderSaved(); }
  });

  document.querySelector(".bar").addEventListener("click", (e) => {
    const act = e.target.closest("[data-act]")?.dataset.act;
    if (act === "new" && confirm("Commencer un nouveau menu ? (pensez à enregistrer celui-ci)")) { m = blank(); fill(); }
    if (act === "save") { const list = load().filter((y) => y.id !== m.id); list.push({ ...m, saved: new Date().toISOString() }); store(list); renderSaved(); e.target.textContent = "Enregistré ✓"; setTimeout(() => (e.target.textContent = "Enregistrer"), 1500); }
    if (act === "print") window.print();
    if (act === "logout") { try { localStorage.removeItem("triann-admin-cle"); } catch {} location.reload(); }
  });
  $("[data-act=add-course]").addEventListener("click", () => { m.courses.push({ t: "Nouvelle étape", items: [] }); renderCourses(); render(); });

  // Export / import d'un fichier (pour passer d'un appareil à l'autre)
  $("[data-act=export]").addEventListener("click", () => {
    const a = document.createElement("a");
    a.href = URL.createObjectURL(new Blob([JSON.stringify(load(), null, 2)], { type: "application/json" }));
    a.download = `menus-tri-ann-${new Date().toISOString().slice(0, 10)}.json`; a.click();
  });
  $("[data-import]").addEventListener("change", async (e) => {
    try {
      const incoming = JSON.parse(await e.target.files[0].text());
      const list = load(); for (const x of incoming) if (x && x.id && !list.some((y) => y.id === x.id)) list.push(x);
      store(list); renderSaved(); alert(`${incoming.length} menu(s) importé(s).`);
    } catch { alert("Fichier non reconnu."); }
    e.target.value = "";
  });

  addEventListener("triann:view", (e) => { if (e.detail === "menus") render(); });
  fill(); renderSaved();
})();
</script>

{% include "admin-factures.njk" %}

<ul class="suggest" role="listbox" hidden></ul>
<script>
// Liste des plats de la carte pour les champs [data-suggest] (onglets Menus et Factures).
// Choisir un plat écrit « Nom — Rubrique » dans le champ et déclenche son événement input, que chaque outil traite.
(() => {
  const CATALOG = JSON.parse(document.getElementById("data-catalog").textContent);
  const box = document.querySelector(".suggest");
  const plain = (s) => String(s || "").normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
  const esc = (s) => String(s ?? "").replace(/[&<>"']/g, (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]);
  const price = (p) => (p == null || p === "" ? "" : Number(p).toFixed(2).replace(".", ",") + " €");
  let input = null, hits = [], active = -1;

  const close = () => { box.hidden = true; hits = []; active = -1; input?.setAttribute("aria-expanded", "false"); };
  function place() {
    if (!input || box.hidden) return;
    const r = input.getBoundingClientRect();
    const below = innerHeight - r.bottom - 12, above = r.top - 12;
    const up = below < 220 && above > below;
    Object.assign(box.style, { left: r.left + "px", width: r.width + "px", maxHeight: Math.min(340, up ? above : below) + "px", top: up ? "" : r.bottom + 4 + "px", bottom: up ? innerHeight - r.top + 4 + "px" : "" });
  }
  function open(el) {
    input = el;
    const words = plain(el.value).split(/\s+/).filter(Boolean);
    if (!words.length) return close();
    // Plats de la carte, puis en dernier : ajouter le texte tapé tel quel (ligne libre)
    // (ceux dont le nom contient les mots tapés d'abord)
    const inName = (c) => words.every((w) => plain(c.n).includes(w));
    const found = CATALOG.filter((c) => { const t = plain(c.n + " " + c.g); return words.every((w) => t.includes(w)); });
    hits = [...found.filter(inName), ...found.filter((c) => !inName(c))].slice(0, 40).concat({ free: el.value.trim() });
    active = 0;
    box.innerHTML = hits.map((c, i) => c.free != null
      ? `<li role="option" class="free" data-i="${i}" aria-selected="${i === active}">Ajouter « <b>${esc(c.free)}</b> » tel quel</li>`
      : `<li role="option" data-i="${i}" aria-selected="${i === active}"><b>${esc(c.n)}</b><small>${esc(c.g)}</small><span>${price(c.p)}</span></li>`).join("");
    box.hidden = false; el.setAttribute("aria-expanded", "true");
    place();
  }
  function pick(i) {
    const c = hits[i], el = input; if (!c || !el) return;
    close();
    // Ligne libre : même effet qu'Entrée dans le champ
    if (c.free != null) return el.dispatchEvent(new KeyboardEvent("keydown", { key: "Enter", bubbles: true }));
    el.value = `${c.n} — ${c.g}`;
    el.dispatchEvent(new Event("input", { bubbles: true }));
  }
  function move(d) {
    if (!hits.length) return;
    active = (active + d + hits.length) % hits.length;
    box.querySelectorAll("li").forEach((li, i) => li.setAttribute("aria-selected", String(i === active)));
    box.children[active].scrollIntoView({ block: "nearest" });
  }

  document.addEventListener("input", (e) => { if (e.target.matches?.("[data-suggest]") && e.isTrusted) open(e.target); });
  document.addEventListener("focusin", (e) => { if (e.target.matches?.("[data-suggest]")) open(e.target); });
  document.addEventListener("focusout", (e) => { if (e.target === input) setTimeout(() => { if (document.activeElement !== input) close(); }, 120); });
  // Avant les outils : Entrée sur un plat de la liste le choisit (sinon le texte libre est ajouté comme avant)
  document.addEventListener("keydown", (e) => {
    if (box.hidden || e.target !== input) return;
    if (e.key === "ArrowDown" || e.key === "ArrowUp") { e.preventDefault(); move(e.key === "ArrowDown" ? 1 : -1); }
    else if (e.key === "Escape") close();
    else if (e.key === "Enter" && active >= 0) { e.preventDefault(); e.stopImmediatePropagation(); pick(active); }
  }, true);
  box.addEventListener("mousedown", (e) => { e.preventDefault(); const li = e.target.closest("li[data-i]"); if (li) pick(+li.dataset.i); });
  box.addEventListener("mousemove", (e) => { const li = e.target.closest("li[data-i]"); if (li && +li.dataset.i !== active) { active = +li.dataset.i; box.querySelectorAll("li").forEach((x, i) => x.setAttribute("aria-selected", String(i === active))); } });
  addEventListener("scroll", place, true);
  addEventListener("resize", place);
})();
</script>
<script>
// Choix de l'outil (menus / factures), retenu sur l'appareil
(() => {
  const KEY = "triann-admin-vue";
  const show = (v) => {
    document.body.dataset.view = v;
    document.querySelectorAll(".tabs [data-view]").forEach((b) => b.setAttribute("aria-pressed", String(b.dataset.view === v)));
    try { localStorage.setItem(KEY, v); } catch { /* navigation privée */ }
    dispatchEvent(new CustomEvent("triann:view", { detail: v }));
    scrollTo(0, 0);
  };
  // L'aperçu garde la mise en page A4 et se réduit pour tenir dans la largeur (téléphone, petit écran)
  const fit = () => document.querySelectorAll(".preview-wrap").forEach((w) => {
    const s = w.querySelector(".sheet, .invoice");
    if (!s || !w.clientWidth) return;
    s.style.zoom = "";
    s.style.zoom = Math.min(1, w.clientWidth / s.offsetWidth);
  });
  addEventListener("resize", fit);
  addEventListener("triann:view", fit);
  document.querySelector(".tabs").addEventListener("click", (e) => { const v = e.target.closest("[data-view]")?.dataset.view; if (v) show(v); });
  let start = "menus";
  try { start = localStorage.getItem(KEY) === "factures" ? "factures" : "menus"; } catch { /* navigation privée */ }
  show(start);
})();
</script>
