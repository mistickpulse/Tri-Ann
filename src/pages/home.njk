---
layout: base.njk
pagination:
  data: site.langs
  size: 1
  alias: lang
permalink: "{{ site.routes.home[lang] }}"
pageKey: home
eleventyComputed:
  title: "Tri-Ann · {{ 'home.title' | t(lang) }}"
  description: "{{ 'home.description' | t(lang) }}"
scripts: ["/assets/js/reviews.js", "/assets/js/events.js"]
---
{%- from "icons.njk" import icon -%}
{%- from "partials.njk" import restoCard, specialCard, reviewsBlock, eventsCalendar -%}

<section class="hero">
  {#- La vidéo remplacera l'image : <video autoplay muted loop playsinline poster="…"> #}
  <img class="hero-media" src="/assets/img/galette-sarasin.jpg" alt="" width="1080" height="665" fetchpriority="high">
  <div class="wrap hero-content">
    <h1>{{ "home.heroTitle" | t(lang) }}</h1>
    <p>{{ "home.heroText" | t(lang) }}</p>
    <div class="ctas">
      <a class="btn btn-primary btn-lg" href="{{ site.routes | route('menu', lang) }}">{{ icon("book", 20) }} {{ "home.seeMenu" | t(lang) }}</a>
      <a class="btn btn-ghost btn-lg on-dark" href="#restaurants">{{ icon("pin", 20) }} {{ "nav.restaurants" | t(lang) }}</a>
    </div>
  </div>
</section>

<section class="band band-alt" aria-labelledby="reviews-title">
  <div class="wrap">
    <h2 id="reviews-title" class="sr-only">{{ "reviews.title" | t(lang) }}</h2>
    {{ reviewsBlock(["moussy-le-neuf", "lagny-le-sec", "saint-maximin"], lang, restaurants) }}
  </div>
</section>

<section class="band" id="speciales" aria-labelledby="specials-title">
  <div class="wrap">
    <p class="eyebrow">{{ "home.specialsEyebrow" | t(lang) }}</p>
    <h2 id="specials-title">{{ "home.specialsTitle" | t(lang) }}</h2>
    <div class="specials-bar">
    <div class="tabs" role="tablist" data-tabs>
      {%- for r in restaurants %}
      <button role="tab" id="tab-{{ r.slug }}" aria-controls="panel-{{ r.slug }}" aria-selected="{{ 'true' if loop.first else 'false' }}"{% if not loop.first %} tabindex="-1"{% endif %}>{{ r.city }}</button>
      {%- endfor %}
    </div>
    <div class="specials-more">
      <a class="btn btn-primary" href="{{ site.routes | route('menu', lang) }}?speciales=1">{{ icon("book", 18) }} {{ "specials.seeInMenu" | t(lang) }}</a>
      <button class="btn btn-ghost" type="button" data-open-dialog="newsletter-dialog">{{ icon("mail", 18) }} {{ "newsletter.cta" | t(lang) }}</button>
    </div>
    </div>
    {%- for r in restaurants %}
    {%- set specials = collections.specials | forRestaurant(r.slug) %}
    <div class="tab-panel" role="tabpanel" id="panel-{{ r.slug }}" aria-labelledby="tab-{{ r.slug }}"{% if not loop.first %} hidden{% endif %}>
      {%- if specials.length %}
      <div class="grid-cards">
        {%- for s in specials %}{{ specialCard(s, lang) }}{% endfor %}
      </div>
      {%- else %}
      <p class="muted">{{ "home.noSpecials" | t(lang) }}</p>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>
</section>

<section class="band" id="restaurants" aria-labelledby="restos-title">
  <div class="wrap">
    <p class="eyebrow">{{ "home.restosEyebrow" | t(lang) }}</p>
    <h2 id="restos-title">{{ "home.restosTitle" | t(lang) }}</h2>
    <div class="grid-cards">
      {%- for r in restaurants %}{{ restoCard(r, lang, site) }}{% endfor %}
    </div>
    <div class="booking-note">
      {{ icon("phone", 20) }}
      <p><b>{{ "home.bookingAll" | t(lang) }}</b><br>
      <span class="muted">{{ "home.bookingGroup" | t(lang) }} <a href="{{ site.routes | route('contact', lang) }}">{{ "home.bookingGroupLink" | t(lang) }}</a>.</span></p>
    </div>
  </div>
</section>

<section class="band menu-cta">
  <div class="wrap menu-cta-inner">
    <div>
      <h2>{{ "home.menuCtaTitle" | t(lang) }}</h2>
      <p class="muted">{{ "home.menuCtaText" | t(lang) }}</p>
      <a class="btn btn-primary btn-lg" href="{{ site.routes | route('menu', lang) }}">{{ icon("book", 20) }} {{ "home.seeMenu" | t(lang) }}</a>
    </div>
    <img src="/assets/img/crepe-dessert.png" alt="" loading="lazy" width="609" height="609">
  </div>
</section>

<section class="band band-alt" aria-labelledby="craft-title">
  <div class="wrap split">
    <div>
      <p class="eyebrow">{{ "home.craftEyebrow" | t(lang) }}</p>
      <h2 id="craft-title">{{ "home.craftTitle" | t(lang) }}</h2>
      <ol class="craft-list">
        {%- for c in i18n.craft %}
        <li><b>{{ c.title | tr(lang) }}</b><span class="muted">{{ c.text | tr(lang) }}</span></li>
        {%- endfor %}
      </ol>
    </div>
    <img class="rounded" src="/assets/img/salade.png" alt="" loading="lazy" width="959" height="959">
  </div>
</section>

<section class="band" aria-labelledby="services-title">
  <div class="wrap">
    <p class="eyebrow">{{ "home.servicesEyebrow" | t(lang) }}</p>
    <h2 id="services-title">{{ "home.servicesTitle" | t(lang) }}</h2>
    <div class="grid-services">
      {%- for s in i18n.services %}
      <article class="service">
        <span class="service-ic">{{ icon(s.icon, 24) }}</span>
        <h3>{{ s.title | tr(lang) }}</h3>
        <p class="muted">{{ s.text | tr(lang) }}{% if s.link %} <a href="{{ site.routes | route('contact', lang) }}">{{ s.link | tr(lang) }}</a>.{% endif %}</p>
        {%- if s.action == "takeaway" %}
        <button class="btn btn-ghost service-btn" type="button" data-open-dialog="takeaway-dialog">{{ icon("bag", 18) }} {{ s.actionLabel | tr(lang) }}</button>
        {%- endif %}
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="band band-alt" id="evenements" aria-labelledby="events-title">
  <div class="wrap">
    <p class="eyebrow">{{ "home.eventsEyebrow" | t(lang) }}</p>
    <h2 id="events-title">{{ "home.eventsTitle" | t(lang) }}</h2>
    {{ eventsCalendar(collections.events, lang, restaurants) }}
  </div>
</section>
