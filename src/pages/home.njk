---
layout: base.njk
pagination:
  data: site.langs
  size: 1
  alias: lang
permalink: "{{ site.routes.home[lang] }}"
pageKey: home
eleventyComputed:
  title: "Tri-Ann · {{ 'home.title' | t(lang) }}"
  description: "{{ 'home.description' | t(lang) }}"
scripts: ["/assets/js/events.js"]
---
{%- from "icons.njk" import icon -%}
{%- from "partials.njk" import restoCard, specialCard, reviewsBlock, quotesList, eventsCalendar with context -%}

<section class="hero">
  {#- La vidéo remplacera l'image : <video autoplay muted loop playsinline poster="…"> #}
  <img class="hero-media" src="/assets/img/photos/accueil-1-1600.jpg" srcset="/assets/img/photos/accueil-1-800.jpg 800w, /assets/img/photos/accueil-1-1600.jpg 1600w" sizes="100vw" alt="" width="1600" height="1200" fetchpriority="high" style="--pos: 50% 50%; --pos-m: 55% 50%">
  <div class="wrap hero-content">
    <h1>{{ "home.heroTitle" | t(lang) }}</h1>
    <p>{{ "home.heroLine1" | t(lang) }}<br>{{ "home.heroLine2" | t(lang) }} {{ "home.heroText" | rtag }}</p>
    <div class="ctas">
      <a class="btn btn-primary btn-lg" href="{{ site.routes | route('menu', lang) }}">{{ icon("book", 20) }} {{ "home.seeMenu" | t(lang) }}</a>
      <a class="btn btn-ghost btn-lg on-dark" href="#restaurants">{{ icon("pin", 20) }} {{ "nav.restaurants" | t(lang) }}</a>
    </div>
  </div>
</section>

<section class="band" id="speciales" aria-labelledby="specials-title">
  <div class="wrap">
    <p class="eyebrow">{{ "home.specialsEyebrow" | t(lang) }}</p>
    <h2 id="specials-title">{{ "home.specialsTitle" | t(lang) }}</h2>
    <div class="specials-bar">
    <div class="tabs" role="tablist" data-tabs>
      {%- for r in restaurants %}
      <button role="tab" id="tab-{{ r.slug }}" aria-controls="panel-{{ r.slug }}" aria-selected="{{ 'true' if r.slug == site.defaultSpecialsRestaurant else 'false' }}"{% if r.slug != site.defaultSpecialsRestaurant %} tabindex="-1"{% endif %}>{{ r.city }}</button>
      {%- endfor %}
    </div>
    <div class="specials-more">
      <a class="btn btn-primary" href="{{ site.routes | route('menu', lang) }}?speciales=1">{{ icon("book", 18) }} {{ "specials.seeInMenu" | t(lang) }}</a>
      <button class="btn btn-ghost" type="button" data-open-dialog="newsletter-dialog">{{ icon("mail", 18) }} {{ "newsletter.cta" | t(lang) }}</button>
    </div>
    </div>
    {%- for r in restaurants %}
    {%- set specials = collections.specials | forRestaurant(r.slug) %}
    <div class="tab-panel" role="tabpanel" id="panel-{{ r.slug }}" aria-labelledby="tab-{{ r.slug }}"{% if r.slug != site.defaultSpecialsRestaurant %} hidden{% endif %}>
      {%- if specials.length %}
      <div class="grid-cards">
        {%- for s in specials %}{{ specialCard(s, lang) }}{% endfor %}
      </div>
      {%- else %}
      <p class="muted">{{ "home.noSpecials" | t(lang) }}</p>
      {%- endif %}
    </div>
    {%- endfor %}
  </div>
</section>

<section class="band menu-cta" style="padding-top:0">
  <div class="wrap menu-cta-inner">
    <div>
      <h2>{{ "home.menuCtaTitle" | t(lang) }}</h2>
      <p class="muted">{{ "home.menuCtaText" | t(lang) }} {{ "home.menuCtaText" | rtag }}</p>
      <a class="btn btn-primary btn-lg" href="{{ site.routes | route('menu', lang) }}">{{ icon("book", 20) }} {{ "home.seeMenu" | t(lang) }}</a>
    </div>
    <img src="/assets/img/photos/crepe-fraises-600.jpg" alt="" loading="lazy" width="600" height="600">
  </div>
</section>

<section class="band band-alt" id="restaurants" aria-labelledby="restos-title">
  <div class="wrap">
    <h2 id="restos-title">{{ "home.restosTitle" | t(lang) }}</h2>
    <div class="grid-cards">
      {%- for r in restaurants %}{{ restoCard(r, lang, site, true) }}{% endfor %}
    </div>
    {{ quotesList(null, lang, restaurants) }}
    <div class="booking-note">
      {{ icon("phone", 20) }}
      <p><b>{{ "home.bookingAll" | t(lang) }}</b><br>
      <span class="muted">{{ "home.bookingGroup" | t(lang) }} <a href="{{ site.routes | route('contact', lang) }}">{{ "home.bookingGroupLink" | t(lang) }}</a>.</span> {{ "home.bookingNote" | rtag }}</p>
    </div>
  </div>
</section>

<section class="band" id="occasions" aria-labelledby="services-title">
  <div class="wrap">
    <p class="eyebrow">{{ "home.servicesEyebrow" | t(lang) }}</p>
    <h2 id="services-title">{{ "home.servicesTitle" | t(lang) }}</h2>
    <div class="grid-services">
      {%- for s in i18n.services %}
      <article class="service">
        <span class="service-ic">{{ icon(s.icon, 24) }}</span>
        <h3>{{ s.title | tr(lang) }}</h3>
        <p class="muted">{{ s.text | tr(lang) }}{% if s.link %} <a href="{{ site.routes | route('contact', lang) }}">{{ s.link | tr(lang) }}</a>.{% endif %} {{ ("services." + loop.index0) | rtag }}</p>
        {%- if s.action == "takeaway" %}
        <button class="btn btn-ghost service-btn" type="button" data-open-dialog="takeaway-dialog">{{ icon("bag", 18) }} {{ s.actionLabel | tr(lang) }}</button>
        {%- endif %}
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="band band-alt" id="univers" aria-labelledby="about-title">
  <div class="wrap about">
    <div class="about-intro">
      <p class="eyebrow">{{ "home.aboutEyebrow" | t(lang) }}</p>
      <h2 id="about-title">{{ "home.aboutTitle" | t(lang) }}</h2>
      <p>{{ "home.aboutText1" | t(lang) }} {{ "home.aboutText1" | rtag }}</p>
      <p class="muted">{{ "home.aboutText2" | t(lang) }} {{ "home.aboutText2" | rtag }}</p>
    </div>
    <ol class="craft-list">
      {%- for c in i18n.craft %}
      <li><b>{{ c.title | tr(lang) }}</b><span class="muted">{{ c.text | tr(lang) }} {{ ("craft." + loop.index0) | rtag }}</span></li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="band" id="evenements" aria-labelledby="events-title">
  <div class="wrap">
    <p class="eyebrow">{{ "home.eventsEyebrow" | t(lang) }}</p>
    <h2 id="events-title">{{ "home.eventsTitle" | t(lang) }}</h2>
    {{ eventsCalendar(collections.events, lang, restaurants) }}
  </div>
</section>
